# OpenRouter (primary plan generation + OCR + RAG embeddings)
# Models: inception/mercury-2 (plans), qwen/qwen3-vl-8b-instruct (OCR), qwen/qwen3-embedding-8b (RAG)
OPENROUTER_API_KEY=

# Google Gemini (fallback model for plan generation)
GOOGLE_GENERATIVE_AI_API_KEY=

# Resend (transactional emails)
RESEND_API_KEY=
RESEND_FROM_EMAIL=FitFast <noreply@fitfast.app>

# Web Push (VAPID keys — generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@fitfast.app

# ---------------------------------------------------------------------------
# App URLs — used in emails, CORS, and auth (crossDomain siteUrl)
# Set these on BOTH dev and prod Convex deployments.
# ---------------------------------------------------------------------------
# Dev values:
#   CLIENT_APP_URL=http://localhost:3010
#   ADMIN_APP_URL=http://localhost:3011
#   MARKETING_SITE_URL=http://localhost:3002
#
# Prod values:
#   CLIENT_APP_URL=https://client.fitfast.app
#   ADMIN_APP_URL=https://admin.fitfast.app
#   MARKETING_SITE_URL=https://fitfast.app
CLIENT_APP_URL=
ADMIN_APP_URL=
MARKETING_SITE_URL=

# Seed data (only needed for development)
SEED_USER_PASSWORD=
